# --- Database (Postgres on the VPS) ---
# The app connects as the database owner; Row Level Security applies to
# logged-in users' queries through the `authenticated` role (db/migrations/0000).
# Migrations in db/migrations run automatically when the container starts.
DATABASE_URL=postgres://postgres:password@localhost:5432/gcs

# Signs file download links. Any long random string: `openssl rand -base64 48`.
AUTH_SECRET=change-me

# --- File storage (S3-compatible, e.g. SeaweedFS on the VPS) ---
# Only the server talks to it; it doesn't need to be public.
S3_ENDPOINT=http://gcs-files:8333
S3_BUCKET=gcs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional: public origin used in password-reset links, if not NEXT_PUBLIC_SITE_URL
# (handy on a test address). AUTH_FROM_EMAIL is the sender for those emails;
# unset, it falls back to CAMPAIGN_FROM_EMAIL, then MAIL_FROM_EMAIL.
# APP_URL=https://test.example.sslip.io
# AUTH_FROM_EMAIL=Gray Content Studio <hello@graycontentstudio.co>

# Canonical site URL — the live custom domain.
# Every canonical tag, OG image URL, sitemap entry and JSON-LD @id is built
# from this, so pointing it at the preview host splits SEO authority between
# two hostnames serving identical content.
NEXT_PUBLIC_SITE_URL=https://www.graycontentstudio.co

# --- Diagnostic result email (optional) ---
# Without these the diagnostic still works and still captures leads; it simply
# doesn't send the result email. Resend free tier: resend.com → API Keys.
RESEND_API_KEY=re_your_api_key
# Must be on a domain verified in Resend, or delivery fails.
DIAGNOSTIC_FROM_EMAIL=Gray Content Studio <diagnostic@graycontentstudio.co>
# Optional: where replies go, if different from the sending address.
DIAGNOSTIC_REPLY_TO=hello@graycontentstudio.co
# Optional: overrides the result link base (defaults to the diagnostic subdomain).
DIAGNOSTIC_URL=https://diagnostic.graycontentstudio.co

# --- Seasonal campaign pages ---
# Who the campaign emails come from. These pages are a consumer photography
# promotion, so they send under the studio's own address instead of inheriting
# the diagnostic's sender above. Must be on the domain verified in Resend.
# Unset, campaign mail falls back to MAIL_FROM_EMAIL/DIAGNOSTIC_FROM_EMAIL —
# which means it goes out as diagnostic@, so set this.
CAMPAIGN_FROM_EMAIL=Gray Content Studio <hello@graycontentstudio.co>
# Where the studio's copy of a session request is sent. Falls back to
# DIAGNOSTIC_REPLY_TO, then to the address in src/content/legal.ts, so the
# notification works without setting this at all.
CAMPAIGN_NOTIFY_EMAIL=hello@graycontentstudio.co
# Both messages go through the RESEND_API_KEY above. With the mailer unset,
# requests are still saved and still reach the CRM — neither message is sent.
# Admin - Campaigns prints the addresses actually in use.
